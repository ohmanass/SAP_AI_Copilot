{
	"_version": "2.0.0",
	"sap.app": {
		"id": "com.sapaicopilot.app",
		"type": "application",
		"i18n": {
			"bundleUrl": "i18n/i18n.properties",
			"supportedLocales": [""],
			"fallbackLocale": ""
		},
		"title": "{{appTitle}}",
		"description": "{{appDescription}}",
		"applicationVersion": {
			"version": "1.0.0"
		},
		"dataSources": {
			"copilotApi": {
				"uri": "api/",
				"type": "JSON"
			}
		}
	},
	"sap.ui": {
		"technology": "UI5",
		"icons": {
			"icon": "sap-icon://da"
		},
		"deviceTypes": {
			"desktop": true,
			"tablet": true,
			"phone": true
		}
	},
	"sap.ui5": {
		"rootView": {
			"viewName": "com.sapaicopilot.app.view.App",
			"type": "XML",
			"id": "app"
		},
		"dependencies": {
			"minUI5Version": "1.136.0",
			"libs": {
				"sap.ui.core": {},
				"sap.m": {},
				"sap.tnt": {},
				"sap.ui.layout": {}
			}
		},
		"contentDensities": {
			"compact": true,
			"cozy": true
		},
		"config": {
			"copilot": {
				"apiDataSource": "copilotApi",
				"healthPollingIntervalMs": 30000,
				"chatTimeoutMs": 180000,
				"requestTimeoutMs": 20000
			}
		},
		"models": {
			"i18n": {
				"type": "sap.ui.model.resource.ResourceModel",
				"settings": {
					"bundleName": "com.sapaicopilot.app.i18n.i18n",
					"supportedLocales": [""],
					"fallbackLocale": ""
				}
			}
		},
		"resources": {
			"css": [
				{
					"uri": "css/style.css"
				}
			]
		},
		"routing": {
			"config": {
				"routerClass": "sap.m.routing.Router",
				"type": "View",
				"viewType": "XML",
				"path": "com.sapaicopilot.app.view",
				"controlId": "pageContainer",
				"controlAggregation": "pages",
				"transition": "fade"
			},
			"routes": [
				{
					"name": "chat",
					"pattern": "",
					"target": "chat"
				},
				{
					"name": "conversation",
					"pattern": "chat/{sessionId}",
					"target": "chat"
				},
				{
					"name": "knowledgeBase",
					"pattern": "knowledge-base",
					"target": "knowledgeBase"
				},
				{
					"name": "settings",
					"pattern": "settings",
					"target": "settings"
				}
			],
			"targets": {
				"chat": {
					"id": "chat",
					"name": "Chat",
					"level": 1
				},
				"knowledgeBase": {
					"id": "knowledgeBase",
					"name": "KnowledgeBase",
					"level": 1
				},
				"settings": {
					"id": "settings",
					"name": "Settings",
					"level": 1
				}
			}
		}
	}
}
