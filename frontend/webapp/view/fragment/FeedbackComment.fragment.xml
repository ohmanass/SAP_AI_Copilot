<core:FragmentDefinition
	xmlns="sap.m"
	xmlns:core="sap.ui.core">
	<!-- After a 👎 (already saved): optional comment on what was wrong -->
	<ResponsivePopover
		id="feedbackPopover"
		class="cpFeedbackPopover"
		title="{i18n>feedbackCommentTitle}"
		placement="Top"
		contentWidth="22rem">
		<VBox class="cpFeedbackBody" renderType="Bare">
			<TextArea
				id="feedbackComment"
				value="{feedback>/comment}"
				placeholder="{i18n>feedbackCommentPlaceholder}"
				rows="3"
				maxLength="1000"
				width="100%"
				growing="true"
				growingMaxLines="6"
				valueLiveUpdate="true"/>
		</VBox>
		<endButton>
			<Button text="{i18n>feedbackCommentSkip}" press=".onFeedbackCommentSkip"/>
		</endButton>
		<beginButton>
			<Button
				text="{i18n>feedbackCommentSend}"
				type="Emphasized"
				enabled="{= !!${feedback>/comment} &amp;&amp; ${feedback>/comment}.trim().length > 0 }"
				press=".onFeedbackCommentSend"/>
		</beginButton>
	</ResponsivePopover>
</core:FragmentDefinition>
