<mvc:View
	controllerName="com.sapaicopilot.app.controller.Settings"
	xmlns:mvc="sap.ui.core.mvc"
	xmlns:core="sap.ui.core"
	xmlns:tnt="sap.tnt"
	xmlns="sap.m"
	height="100%">

	<Page id="settingsPage" showHeader="false" backgroundDesign="Transparent" class="cpPage">
		<VBox class="cpContent" renderType="Bare">

			<HBox class="cpPageHeader" alignItems="Center" renderType="Bare">
				<Button icon="sap-icon://menu2" type="Transparent" class="cpMenuBtn" tooltip="{i18n>openMenu}" press=".onOpenSidebar"/>
				<VBox class="cpPageHeaderText" renderType="Bare">
					<Title text="{i18n>settingsTitle}" level="H1" class="cpPageTitle"/>
					<Text text="{i18n>settingsSubtitle}" class="cpPageSubtitle"/>
				</VBox>
				<Button text="{i18n>recheck}" icon="sap-icon://refresh" class="cpGhostBtn" press=".onRefresh" enabled="{= !${settings>/busy} }"/>
			</HBox>

			<MessageStrip type="Error" showIcon="true" text="{settings>/error}" visible="{= !!${settings>/error} }" class="cpStrip"/>

			<!-- Interface language (util/Language.js) -->
			<VBox class="cpCard cpLanguageCard" renderType="Bare">
				<HBox alignItems="Center" renderType="Bare" class="cpCardHeader">
					<core:Icon src="sap-icon://globe" class="cpCardIcon"/>
					<Title text="{i18n>languageTitle}" level="H3" class="cpCardTitle"/>
				</HBox>
				<HBox class="cpLanguageRow" alignItems="Center" renderType="Bare">
					<Label text="{i18n>languageLabel}" labelFor="languageSelect" class="cpRowLabel"/>
					<Select
						id="languageSelect"
						class="cpLanguageSelect"
						selectedKey="{language>/selected}"
						items="{path: 'language>/options', factory: '.createLanguageItem'}"
						enabled="{= !${language>/busy} }"
						busy="{language>/busy}"
						busyIndicatorDelay="0"
						change=".onLanguageChange"/>
				</HBox>
				<MessageStrip
					type="Information"
					showIcon="true"
					text="{language>/progress}"
					visible="{= !!${language>/progress} }"
					class="cpStrip"/>
				<MessageStrip
					type="Error"
					showIcon="true"
					text="{language>/error}"
					visible="{= !!${language>/error} }"
					class="cpStrip"/>
				<MessageStrip
					type="Warning"
					showIcon="true"
					text="{i18n>languageMachineActive}"
					visible="{language>/machine}"
					class="cpStrip"/>
				<Text text="{i18n>languageNote}" class="cpCardNote"/>
			</VBox>

			<!-- AI usage (app/llm/usage.py) -->
			<VBox class="cpCard cpUsageCard" renderType="Bare" busy="{usage>/busy}" busyIndicatorDelay="0">
				<HBox alignItems="Center" renderType="Bare" class="cpCardHeader cpUsageHeader">
					<core:Icon src="sap-icon://measure" class="cpCardIcon"/>
					<Title text="{i18n>usageTitle}" level="H3" class="cpCardTitle"/>
					<SegmentedButton selectedKey="{usage>/days}" selectionChange=".onUsageDaysChange" class="cpUsageDays">
						<items>
							<SegmentedButtonItem key="7" text="{i18n>usageDays7}"/>
							<SegmentedButtonItem key="30" text="{i18n>usageDays30}"/>
							<SegmentedButtonItem key="90" text="{i18n>usageDays90}"/>
						</items>
					</SegmentedButton>
				</HBox>
				<Text text="{usage>/error}" class="cpCardNote" visible="{= !!${usage>/error} }"/>

				<FlexBox class="cpUsageKpis" wrap="Wrap" renderType="Bare">
					<VBox class="cpUsageKpi" renderType="Bare">
						<Text text="{i18n>usageCalls}" class="cpKpiLabel"/>
						<Text text="{path: 'usage>/data/total/calls', formatter: '.formatCount'}" class="cpKpiValue"/>
					</VBox>
					<VBox class="cpUsageKpi" renderType="Bare">
						<Text text="{i18n>usageInputTokens}" class="cpKpiLabel"/>
						<Text text="{path: 'usage>/data/total/prompt_tokens', formatter: '.formatCount'}" class="cpKpiValue"/>
					</VBox>
					<VBox class="cpUsageKpi" renderType="Bare">
						<Text text="{i18n>usageOutputTokens}" class="cpKpiLabel"/>
						<Text text="{path: 'usage>/data/total/completion_tokens', formatter: '.formatCount'}" class="cpKpiValue"/>
					</VBox>
					<VBox class="cpUsageKpi" renderType="Bare">
						<Text text="{i18n>usageCost}" class="cpKpiLabel"/>
						<Text text="{parts: ['usage>/data/total/cost', 'usage>/data/currency'], formatter: '.formatCost'}" class="cpKpiValue"/>
						<Text text="{i18n>usageCostHint}" class="cpKpiHint" visible="{= !${usage>/data/currency} }"/>
					</VBox>
				</FlexBox>

				<!-- Tokens per day: SVG built from numbers only (see formatUsageChart) -->
				<core:HTML content="{path: 'usage>/data/by_day', formatter: '.formatUsageChart'}" sanitizeContent="false"/>

				<Table
					class="cpTable cpUsageTable"
					items="{usage>/data/by_feature}"
					noDataText="{i18n>usageNone}"
					backgroundDesign="Transparent"
					popinLayout="GridSmall">
					<columns>
						<Column><Text text="{i18n>usageColFeature}"/></Column>
						<Column hAlign="End"><Text text="{i18n>usageCalls}"/></Column>
						<Column hAlign="End" minScreenWidth="28rem" demandPopin="true"><Text text="{i18n>usageInputTokens}"/></Column>
						<Column hAlign="End" minScreenWidth="28rem" demandPopin="true"><Text text="{i18n>usageOutputTokens}"/></Column>
						<Column hAlign="End" visible="{= !!${usage>/data/currency} }"><Text text="{i18n>usageCost}"/></Column>
					</columns>
					<items>
						<ColumnListItem>
							<cells>
								<VBox renderType="Bare">
									<Text text="{path: 'usage>feature', formatter: '.formatFeature'}" class="cpUsageFeature"/>
									<Text text="{path: 'usage>feature', formatter: '.formatFeatureHint'}" class="cpCardNote"/>
								</VBox>
								<Text text="{path: 'usage>calls', formatter: '.formatCount'}"/>
								<Text text="{path: 'usage>prompt_tokens', formatter: '.formatCount'}"/>
								<Text text="{path: 'usage>completion_tokens', formatter: '.formatCount'}"/>
								<Text text="{parts: ['usage>cost', 'usage>/data/currency'], formatter: '.formatCost'}"/>
							</cells>
						</ColumnListItem>
					</items>
				</Table>
				<Text text="{i18n>usageNote}" class="cpCardNote"/>
			</VBox>

			<FlexBox class="cpCardGrid" wrap="Wrap" renderType="Bare" busy="{settings>/busy}" busyIndicatorDelay="0">

				<!-- Backend -->
				<VBox class="cpCard" renderType="Bare">
					<HBox alignItems="Center" renderType="Bare" class="cpCardHeader">
						<core:Icon src="sap-icon://it-host" class="cpCardIcon"/>
						<Title text="{i18n>cardBackend}" level="H3" class="cpCardTitle"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelStatus}" class="cpRowLabel"/>
						<ObjectStatus
							text="{= ${app>/backend/state} === 'online' ? ${i18n>valueOnline} : ${i18n>valueOffline} }"
							state="{= ${app>/backend/state} === 'online' ? 'Success' : 'Error' }"
							inverted="true"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelEndpoint}" class="cpRowLabel"/>
						<Text text="{settings>/endpoint}" class="cpRowValue cpMono"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare" visible="{= !!${settings>/status/chat_history} }">
						<Text text="{i18n>labelHistory}" class="cpRowLabel"/>
						<ObjectStatus
							text="{settings>/status/chat_history/backend}"
							state="{= ${settings>/status/chat_history/available} ? 'Success' : 'Error' }"
							tooltip="{= ${settings>/status/chat_history/error} || ${settings>/status/chat_history/location} }"
							inverted="true"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelLastCheck}" class="cpRowLabel"/>
						<Text text="{path: 'settings>/checkedAt', formatter: '.formatter.dateTime'}" class="cpRowValue"/>
					</HBox>
				</VBox>

				<!-- Generative AI -->
				<VBox class="cpCard" renderType="Bare">
					<HBox alignItems="Center" renderType="Bare" class="cpCardHeader">
						<core:Icon src="sap-icon://da" class="cpCardIcon"/>
						<Title text="{i18n>cardAi}" level="H3" class="cpCardTitle"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelProvider}" class="cpRowLabel"/>
						<Text text="{= ${settings>/status/ai/provider} || '—' }" class="cpRowValue"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelCredentials}" class="cpRowLabel"/>
						<ObjectStatus
							visible="{= !!${settings>/status} }"
							text="{= ${settings>/status/ai/configured} ? ${i18n>valueConfigured} : ${i18n>valueNotConfigured} }"
							state="{= ${settings>/status/ai/configured} ? 'Success' : 'Error' }"
							inverted="true"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelChatModel}" class="cpRowLabel"/>
						<tnt:InfoLabel text="{= ${settings>/status/ai/chat_model} || '—' }" colorScheme="6" class="cpToolLabel"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelConnection}" class="cpRowLabel"/>
						<ObjectStatus
							text="{path: 'settings>/status/ai/connection', formatter: '.formatConnection'}"
							state="{= ${settings>/status/ai/connection} ? (${settings>/status/ai/connection/reachable} ? 'Success' : 'Error') : 'None' }"
							inverted="{= !!${settings>/status/ai/connection} }"/>
					</HBox>
					<HBox class="cpCardActions" alignItems="Center" renderType="Bare">
						<Button
							text="{i18n>testConnection}"
							icon="sap-icon://connected"
							class="cpGhostBtn"
							enabled="{= !${settings>/testing} &amp;&amp; !!${settings>/status/ai/configured} }"
							busy="{settings>/testing}"
							busyIndicatorDelay="0"
							press=".onTestConnection"/>
						<Text text="{i18n>testConnectionHint}" class="cpCardNote"/>
					</HBox>
				</VBox>

				<!-- Vector store -->
				<VBox class="cpCard" renderType="Bare">
					<HBox alignItems="Center" renderType="Bare" class="cpCardHeader">
						<core:Icon src="sap-icon://chain-link" class="cpCardIcon"/>
						<Title text="{i18n>cardVector}" level="H3" class="cpCardTitle"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelStatus}" class="cpRowLabel"/>
						<ObjectStatus
							visible="{= !!${settings>/status} }"
							text="{path: 'settings>/status/vector_store/available', formatter: '.formatter.availability'}"
							state="{path: 'settings>/status/vector_store/available', formatter: '.formatter.availabilityState'}"
							inverted="true"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelCollection}" class="cpRowLabel"/>
						<Text text="{= ${settings>/status/vector_store/collection} || '—' }" class="cpRowValue cpMono"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelChunks}" class="cpRowLabel"/>
						<Text text="{= ${settings>/status} ? String(${settings>/status/vector_store/total_chunks}) : '—' }" class="cpRowValue"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelEmbeddingModel}" class="cpRowLabel"/>
						<Text text="{= ${settings>/status/vector_store/embedding_model} || '—' }" class="cpRowValue cpMono"/>
					</HBox>
				</VBox>

				<!-- SAP data -->
				<VBox class="cpCard" renderType="Bare">
					<HBox alignItems="Center" renderType="Bare" class="cpCardHeader">
						<core:Icon src="sap-icon://database" class="cpCardIcon"/>
						<Title text="{i18n>cardDatabase}" level="H3" class="cpCardTitle"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelDataSource}" class="cpRowLabel"/>
						<tnt:InfoLabel text="{= ${settings>/status/sap_data/label} || '—' }" colorScheme="6" class="cpToolLabel"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelStatus}" class="cpRowLabel"/>
						<ObjectStatus
							visible="{= !!${settings>/status} }"
							text="{path: 'settings>/status/sap_data/available', formatter: '.formatter.availability'}"
							state="{path: 'settings>/status/sap_data/available', formatter: '.formatter.availabilityState'}"
							tooltip="{settings>/status/sap_data/error}"
							inverted="true"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelSystem}" class="cpRowLabel"/>
						<Text text="{= ${settings>/status/sap_data/system} || '—' }" class="cpRowValue cpMono"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare" visible="{= !!${settings>/status/sap_data/mode} }">
						<Text text="{i18n>labelConnection}" class="cpRowLabel"/>
						<Text
							text="{parts: ['settings>/status/sap_data/mode', 'settings>/status/sap_data/destination'], formatter: '.formatSapConnection'}"
							class="cpRowValue cpMono"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare" visible="{= !!${settings>/status/sap_data/api} }">
						<Text text="{i18n>labelApi}" class="cpRowLabel"/>
						<Text text="{settings>/status/sap_data/api}" class="cpRowValue cpMono"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelPurchaseOrders}" class="cpRowLabel"/>
						<Text text="{path: 'settings>/status/sap_data/purchase_orders', formatter: '.formatCount'}" class="cpRowValue"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare" visible="{= !!${settings>/status/sap_data/latency_ms} }">
						<Text text="{i18n>labelLatency}" class="cpRowLabel"/>
						<Text text="{path: 'settings>/status/sap_data/latency_ms', formatter: '.formatLatency'}" class="cpRowValue"/>
					</HBox>
					<Text
						text="{= ${settings>/status/sap_data/key} === 'odata' ? ${i18n>dataSourceNoteOdata} : ${i18n>dataSourceNoteSqlite} }"
						class="cpCardNote"/>
				</VBox>

				<!-- Frontend -->
				<VBox class="cpCard" renderType="Bare">
					<HBox alignItems="Center" renderType="Bare" class="cpCardHeader">
						<core:Icon src="sap-icon://laptop" class="cpCardIcon"/>
						<Title text="{i18n>cardFrontend}" level="H3" class="cpCardTitle"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelUi5Version}" class="cpRowLabel"/>
						<Text text="{settings>/ui5Version}" class="cpRowValue cpMono"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelTheme}" class="cpRowLabel"/>
						<Text text="{settings>/theme}" class="cpRowValue cpMono"/>
					</HBox>
					<HBox class="cpRow" renderType="Bare">
						<Text text="{i18n>labelAppVersion}" class="cpRowLabel"/>
						<Text text="{settings>/appVersion}" class="cpRowValue cpMono"/>
					</HBox>
				</VBox>

				<!-- Security -->
				<VBox class="cpCard" renderType="Bare">
					<HBox alignItems="Center" renderType="Bare" class="cpCardHeader">
						<core:Icon src="sap-icon://locked" class="cpCardIcon"/>
						<Title text="{i18n>cardSecurity}" level="H3" class="cpCardTitle"/>
					</HBox>
					<Text text="{i18n>securityText}" class="cpCardText"/>
				</VBox>
			</FlexBox>
		</VBox>
	</Page>
</mvc:View>
