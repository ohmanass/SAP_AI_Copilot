# SAP AI Core service key (from your BTP subaccount) — copy to .env and fill in
AICORE_CLIENT_ID=
AICORE_CLIENT_SECRET=
AICORE_AUTH_URL=
AICORE_BASE_URL=
AICORE_RESOURCE_GROUP=

# Models deployed in SAP Generative AI Hub
GENAI_MODEL_NAME=gpt-4o-mini
# EMBEDDING_MODEL_NAME=text-embedding-3-large

# SAP transactional data used by the agent's tools
#   sqlite = local demo database (fictitious data, works offline)
#   odata  = SAP S/4HANA Cloud via OData V4 (API_PURCHASEORDER_2)
SAP_DATA_SOURCE=sqlite
# API key from https://api.sap.com (log on, open the "Purchase Order" OData V4 API, "Show API Key")
SAP_API_KEY=
# SAP_API_BASE_URL=https://sandbox.api.sap.com/s4hanacloud
# Quantity units checked by the overdue analysis (OData requires a unit when filtering quantities)
# SAP_QUANTITY_UNITS=PC,EA
